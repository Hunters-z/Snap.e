# snap.e environment configuration
PORT=3000

# --- Firebase (required) ---
# Create a project at https://console.firebase.google.com, enable
# Authentication (Google + Email/Password) and Firestore, then copy the
# web app config values below.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_FIREBASE_DATABASE_ID=(default)

# --- Admin (required) ---
# Comma-separated list of emails that get admin access when they sign in.
VITE_ADMIN_EMAILS=you@example.com

# --- Album API (optional, self-hosted server.ts) ---
# Secret used to sign album upload tokens. Set a long random string.
ALBUM_SECRET=change-me-to-a-long-random-string

# --- Metered TURN (client-safe) ---
VITE_TURN_URL=turn:global.relay.metered.ca:80,...(comma separated)
VITE_TURN_USERNAME=your-metered-username
VITE_TURN_CREDENTIAL=your-metered-credential

# --- DOKU payment gateway (client-safe fields only) ---
# secretKey/server-key must NEVER be set with a VITE_ prefix — it would ship
# to the browser. Payment secrets belong server-side only.
VITE_DOKU_MERCHANT_ID=your-merchant-id
VITE_DOKU_CLIENT_KEY=pk_live_...
