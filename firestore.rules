rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '0601randikurnia.s@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation for Print Orders
    function isValidPrintOrder(data) {
      return data.keys().hasAll(['customerName', 'phone', 'address', 'paperType', 'totalPrice', 'status'])
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30
        && data.address is string && data.address.size() > 0 && data.address.size() <= 300
        && data.paperType is string && data.paperType.size() <= 100
        && data.totalPrice is number && data.totalPrice >= 0
        && data.status in ['pending', 'printing', 'ready', 'shipped'];
    }

    // Validation for Studio Config
    function isValidStudioConfig(data) {
      return data.keys().hasAll(['price'])
        && data.price is number && data.price >= 0;
    }

    // Validation for Photostrip Sessions
    function isValidPhotostrip(data) {
      return data.keys().hasAll(['userName', 'layout'])
        && data.userName is string && data.userName.size() <= 100
        && data.layout is string && data.layout.size() <= 20;
    }

    // 0. Users Collection — each user reads/writes only their own doc;
    // admins can read all (admin dashboard user list) and delete.
    match /users/{userId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow delete: if isAdmin();
    }

    // 1. Print Orders Collection — customers create pending orders and read
    // their own; only admins read all / update / delete.
    match /print_orders/{orderId} {
      allow create: if isSignedIn() && isValidId(orderId) && isValidPrintOrder(incoming())
        && incoming().status == 'pending'
        && (!('uid' in incoming()) || incoming().uid == request.auth.uid);
      allow get, list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin() && isValidId(orderId) && isValidPrintOrder(incoming());
      allow delete: if isAdmin();
    }

    // 2. Studio Config Collection — public pricing/config read; admin-only write.
    match /studio_config/{configId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(configId) && isValidStudioConfig(incoming());
    }

    // 3. Photostrip Shared Sessions — public read; signed-in create/update.
    match /photostrips/{sessionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(sessionId) && isValidPhotostrip(incoming());
      allow update: if isSignedIn() && isValidId(sessionId) && isValidPhotostrip(incoming());
      allow delete: if isAdmin();
    }

    // 4. LDR Realtime Signaling & Rooms (WebRTC peer-to-peer exchange)
    // Hosts stamp hostId = auth.uid on first write; any signed-in session
    // (anonymous auth) may join/relay signaling for the room.
    match /ldr_rooms/{roomId} {
      // Per SPECTRE patch: any signed-in session (anonymous auth) may relay
      // signaling — both host and guest must write presence/album pointers.
      allow read, write: if isSignedIn();
    }

    // 5. Cloud Albums Collection (Retained for 7 days in cloud)
    // Owner-scoped: ownerId = auth.uid is stamped by the client on create.
    match /cloud_albums/{sessionId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /photos/{photoId} {
        allow read, write: if isSignedIn() &&
          get(/databases/$(database)/documents/cloud_albums/$(sessionId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
